# Copy this file to .env.openai, then paste your real OpenAI API key there.
# Keep .env.openai local. Do not commit it.

OPENAI_API_KEY=your_openai_api_key_here

# Optional image generation settings. Leave these as-is unless you want to experiment.
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=high

# Optional avatar generation settings.
OPENAI_AVATAR_MODEL=gpt-image-1
OPENAI_AVATAR_SIZE=1024x1536
OPENAI_AVATAR_QUALITY=high
